{
  "run_plan_version": "a5-pilot-v1",
  "prepared_by": "OpenCode (labelling)",
  "prepared_on": "2026-10-05",
  "notes": "Pilot config for the measured 100-review cost/runtime calculator. COLD uses an empty result cache; WARM reuses it and must make ZERO new enrichment calls under identical settings.",

  "client": {
    "provider": "typesafe",
    "model": "jev-latest",
    "endpoint": "https://api.typesafe.ai/v1/systemone",
    "api_key_env": "TYPESAFE_API_KEY",
    "timeout_seconds": 60,
    "needs_review_threshold": 0.5
  },

  "label_config": "typesafe/jev-latest:prompt-v1:schema-a5-v1",
  "prompt_version": "v1",
  "schema_version": "a5-v1",

  "batching": {
    "max_reviews_per_request": 50,
    "size_by_tokens": true,
    "token_budget": 32000,
    "measured_max_reviews_per_request": 36
  },

  "result_cache": {
    "enabled": true,
    "key": "exact review_text + label_config",
    "cold": "empty cache",
    "warm": "reuse cache; zero new enrichment calls"
  },

  "verify": {
    "sample_fraction": 0.1,
    "declared": true,
    "note": "independent re-label on a declared sample; saved disagreement report"
  },

  "limits": {
    "workers": 1,
    "spend_cap_usd": 1.0,
    "output_token_cap": null,
    "max_fallback_fraction": 0.0,
    "retry_policy": "bounded retries with backoff+jitter; honor Retry-After on 429"
  },

  "stages": ["enrich", "verify", "group", "rank", "memo"],

  "runs": {
    "cold": {
      "run_id": "cost_100-cold-2026-10-05",
      "input_csv": "cost_100.csv",
      "output_dir": "cost/pilot/cold",
      "phase": "initial",
      "cache": "empty",
      "purpose": "measured cold pilot; all attempts/failures accounted"
    },
    "warm": {
      "run_id": "cost_100-warm-2026-10-05",
      "input_csv": "cost_100.csv",
      "output_dir": "cost/pilot/warm",
      "phase": "resume",
      "cache": "reuse cold results",
      "purpose": "zero new enrichment calls; measure warm wall time + incremental cost"
    }
  }
}
