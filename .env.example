# Copy to .env (git-ignored) and fill in locally. Never commit real keys.
# With every key blank, all commands run offline (dry-run / replay) and make no paid calls.
# Jev direct from TypeSafe (default enrichment provider)
TYPESAFE_API_KEY=
# Chat roles (verify / group / memo) via OpenRouter, and alternative enrichment route
OPENROUTER_API_KEY=
# Optional alternatives
DEEPSEEK_API_KEY=
BEATAPI_API_KEY=
