# Copy to .env (git-ignored) and fill in locally. Never commit real keys.
# With every key blank, all commands run offline (dry-run / replay) and make no paid calls.
# Jev direct from TypeSafe (default enrichment provider)
TYPESAFE_API_KEY=
# Chat roles (verify / group / memo): Claude Haiku 4.5 via the Anthropic API (pay-as-you-go, separate from a Claude subscription)
ANTHROPIC_API_KEY=
# Only for organization-level keys (not scoped to a workspace): the workspace ID, wrkspc_...
ANTHROPIC_WORKSPACE_ID=
# Alternative chat route and alternative enrichment route
OPENROUTER_API_KEY=
# Optional alternatives
DEEPSEEK_API_KEY=
BEATAPI_API_KEY=
